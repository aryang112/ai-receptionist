    {
      "id": "eyebrow_tinting",
      "displayName": "Eyebrow Tinting",
      "aliases": [
        "eyebrow tinting",
        "eyebrow tint",
        "brow tinting",
        "brow tint",
        "brow thread tint"
      ],
      "facts": [
        {
          "topic": "longevity",
          "text": "Eyebrow tint generally remains visible on the brow hairs for about three to four weeks, while any stain on the skin usually fades sooner.",
          "qualifiers": [
            "Longevity varies with hair growth, skin type, cleansing, exfoliation, skincare products, and swimming."
          ],
          "scope": "general",
          "reviewStatus": "voice_ready",
          "safety": "low",
          "sourceUrl": "https://www.richasthreading.com/_files/ugd/820321_fbd40d0c7b514ea68b564ad835765948.pdf",
          "corroboratingUrl": "https://browcodepro.com/pages/faqs"
        },
        {
          "topic": "aftercare",
          "text": "For the first twenty-four to forty-eight hours, be gentle with the brow area and avoid rubbing, exfoliating products, active skincare, and excessive heat or steam there.",
          "qualifiers": [
            "Exfoliation and chlorinated water can make the tint fade faster."
          ],
          "scope": "general",
          "reviewStatus": "voice_ready",
          "safety": "low",
          "sourceUrl": "https://www.richasthreading.com/_files/ugd/820321_fbd40d0c7b514ea68b564ad835765948.pdf",
          "corroboratingUrl": "https://browcodepro.com/pages/faqs"
        },
        {
          "topic": "patch_test",
          "text": "Patch-test requirements must be confirmed with Richa before giving a definite salon policy.",
          "qualifiers": [],
          "scope": "salon",
          "reviewStatus": "needs_owner_review",
          "safety": "sensitive",
          "sourceUrl": "https://www.richasthreading.com/_files/ugd/820321_fbd40d0c7b514ea68b564ad835765948.pdf"
        }
      ]
    },
    {
      "id": "brow_lamination",
      "displayName": "Brow Lamination",
      "aliases": [
        "brow lamination",
        "eyebrow lamination",
        "brow laminate",
        "eyebrow lifting",
        "eye brow threading lamination bundle"
      ],
      "facts": [
        {
          "topic": "overview",
          "text": "Brow lamination softens and redirects the existing brow hairs, then sets them into a fuller or more neatly brushed shape.",
          "qualifiers": [],
          "scope": "salon",
          "reviewStatus": "voice_ready",
          "safety": "low",
          "sourceUrl": "https://www.richasthreading.com/brow-lamination-parkville-md"
        },
        {
          "topic": "process",
          "text": "The service uses a lifting solution to make the brow hairs flexible, shapes them, sets them with a second solution, and finishes with nourishing oil; tint may be added for more depth.",
          "qualifiers": [],
          "scope": "salon",
          "reviewStatus": "voice_ready",
          "safety": "low",
          "sourceUrl": "https://www.richasthreading.com/brow-lamination-parkville-md"
        },
        {
          "topic": "longevity",
          "text": "Brow lamination typically lasts about four to six weeks.",
          "qualifiers": [
            "Results vary with the natural brow hairs and aftercare."
          ],
          "scope": "salon",
          "reviewStatus": "voice_ready",
          "safety": "low",
          "sourceUrl": "https://www.richasthreading.com/brow-lamination-parkville-md",
          "corroboratingUrl": "https://elleebana.com/faqs/brow-lamination/"
        },
        {
          "topic": "suitability",
          "text": "It can help sparse or unruly brows look fuller by arranging the hairs that are already present, but it cannot add hair where there is none.",
          "qualifiers": [],
          "scope": "salon",
          "reviewStatus": "voice_ready",
          "safety": "low",
          "sourceUrl": "https://www.richasthreading.com/brow-lamination-parkville-md"
        },
        {
          "topic": "expected_results",
          "text": "The expected result is a smoother, fuller-looking brow that can be styled fluffy or sleek.",
          "qualifiers": [
            "The result depends on the amount, direction, and density of the natural brow hair."
          ],
          "scope": "salon",
          "reviewStatus": "voice_ready",
          "safety": "low",
          "sourceUrl": "https://www.richasthreading.com/brow-lamination-parkville-md"
        },
        {
          "topic": "patch_test",
          "text": "The website recommends a patch test, but the exact timing and whether it is mandatory need owner confirmation.",
          "qualifiers": [],
          "scope": "salon",
          "reviewStatus": "needs_owner_review",
          "safety": "sensitive",
          "sourceUrl": "https://www.richasthreading.com/brow-lamination-parkville-md"
        }
      ]
    },
    {
      "id": "lash_lift",
      "displayName": "Lash Lift",
      "aliases": [
        "lash lift",
        "lash lamination",
        "eyelash lift",
        "eyelash lamination",
        "lash perm"
      ],
      "facts": [
        {
          "topic": "overview",
          "text": "A lash lift reshapes and curls the natural lashes rather than attaching extension fibers; a tint can add darker definition.",
          "qualifiers": [],
          "scope": "salon",
          "reviewStatus": "voice_ready",
          "safety": "low",
          "sourceUrl": "https://www.richasthreading.com/lash-lamination-and-tint-carney-md"
        },
        {
          "topic": "process",
          "text": "The natural lashes are arranged on a silicone shield, lifted and set with professional solutions, then conditioned; tint may be included for definition.",
          "qualifiers": [],
          "scope": "salon",
          "reviewStatus": "voice_ready",
          "safety": "low",
          "sourceUrl": "https://www.richasthreading.com/lash-lamination-and-tint-carney-md"
        },
        {
          "topic": "expected_results",
          "text": "The expected result is a more curled and defined appearance using the client's natural lashes.",
          "qualifiers": [
            "Results depend on natural lash length, density, and growth cycle."
          ],
          "scope": "salon",
          "reviewStatus": "voice_ready",
          "safety": "low",
          "sourceUrl": "https://www.richasthreading.com/lash-lamination-and-tint-carney-md"
        },
        {
          "topic": "longevity",
          "text": "The salon page currently gives both four-to-six-week and six-to-eight-week ranges.",
          "qualifiers": [],
          "scope": "salon",
          "reviewStatus": "conflicting",
          "safety": "low",
          "sourceUrl": "https://www.richasthreading.com/lash-lamination-and-tint-carney-md",
          "corroboratingUrl": "https://elleebana.com/category/elleebana/lash-lift/"
        },
        {
          "topic": "aftercare",
          "text": "The salon page says to avoid water, steam, moisture, and mascara for twenty-four to forty-eight hours, while the named manufacturer's current guidance says water itself does not undo the lift.",
          "qualifiers": [],
          "scope": "salon",
          "reviewStatus": "conflicting",
          "safety": "low",
          "sourceUrl": "https://www.richasthreading.com/lash-lamination-and-tint-carney-md",
          "corroboratingUrl": "https://elleebana.com/lash-lift-aftercare-the-elleebana-way/"
        },
        {
          "topic": "patch_test",
          "text": "Patch-test guidance varies across the salon materials and requires owner approval before it is stated as policy.",
          "qualifiers": [],
          "scope": "salon",
          "reviewStatus": "needs_owner_review",
          "safety": "sensitive",
          "sourceUrl": "https://www.richasthreading.com/_files/ugd/820321_fbd40d0c7b514ea68b564ad835765948.pdf"
        },
        {
          "topic": "contraindications",
          "text": "The salon does not have approved pregnancy or contraindication guidance for lash lifts, so please confirm with Richa and your clinician before booking.",
          "qualifiers": [],
          "scope": "salon",
          "reviewStatus": "voice_ready",
          "safety": "medical",
          "delivery": "verbatim",
          "sourceUrl": "https://elleebana.com/category/elleebana/lash-lift/"
        }
      ]
    },
