PORT=5050
NODE_ENV=development
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_REALTIME_API_KEY=sk-REPLACE_ME
OPENAI_REALTIME_MODEL=gpt-realtime
# Voice: cedar/marin are OpenAI's newest, most natural (recommended). Others:
# alloy, ash, ballad, coral, echo, sage, shimmer, verse. Change + restart to A/B test.
OPENAI_REALTIME_VOICE=cedar
# Turn-detection / background-noise tuning. Raise the threshold toward 0.7-0.8
# if background noise makes Erica cut herself off. noise_reduction: near_field
# (phone/close-talking) | far_field | off.
OPENAI_VAD_THRESHOLD=0.6
OPENAI_VAD_SILENCE_MS=500
OPENAI_VAD_PREFIX_MS=300
OPENAI_NOISE_REDUCTION=near_field
# Optional: cap any single Phorest API call (ms) before it aborts. Default 4000.
PHOREST_TIMEOUT_MS=4000
TIMEZONE=America/New_York
USE_MOCK_PHOREST=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
PHOREST_BASE_URL=https://api-gateway-us.phorest.com/third-party-api-server
PHOREST_API_USERNAME=
PHOREST_API_SECRET=
PHOREST_BUSINESS_ID=
PHOREST_BRANCH_ID=
PHOREST_PRIMARY_STAFF_ID=
PHOREST_PREFERRED_SERVICE_IDS=

# WebSocket auth for the Twilio media stream. Empty = dev-permissive (skip
# verification but warn). REQUIRED in production — the server refuses to boot
# without it (fail-closed). Generate with `openssl rand -hex 32`. TTL in seconds.
WS_AUTH_SECRET=REPLACE_WITH_32_RANDOM_BYTES_HEX
# WS_TOKEN_TTL_SECONDS=300

# Rate limiting (per-IP, sliding window). /twilio/* looser, /api/* stricter.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# API_RATE_LIMIT_MAX=30

# Caller lookup cache: how long the phone->client index stays warm (hours).
# CLIENT_INDEX_TTL_HOURS=1

# Append-only call log (JSONL) for the admin surface / auditing.
# CALL_STORE_PATH=./data/calls.jsonl
